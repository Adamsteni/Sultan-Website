# ---------------------------------------------------------------------------
# Sultan Clothing — copy this file to .env and fill in your own keys.
# .env is never served to the browser and must never be committed.
# ---------------------------------------------------------------------------

PORT=3000
SITE_URL=http://localhost:3000
SHOP_NAME=Sultan Clothing
SHOP_EMAIL=dripwithsultan@gmail.com

# Supabase — Dashboard -> Project Settings -> API
# Run db/schema.sql in the SQL editor first, then: npm run seed
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud — APIs & Services -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com

# Mailgun — account -> Sending -> Domain -> API keys
MAILGUN_API_KEY=key-0000000000000000000000000000
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=Sultan Clothing <orders@mg.yourdomain.com>

# Shop owner access. Comma separated. Only these addresses can open /admin.html
ADMIN_EMAILS=dripwithsultan@gmail.com

# Force the in-memory demo store even if Supabase keys are present.
# DEMO_MODE=false
